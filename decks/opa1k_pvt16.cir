* GF180 16,000-Task Scattered Post-PEX Op-Amp PVT Bundle (1,000 Distinct Designs x 16 PVT Corners)
* Each task runs: source + option temp + alter(VDD,Ibias,Vinp) + OP + AC(dec 20, 1Hz..1GHz) + 10mV Step Tran + teardown
.control
set noaskquit
set nomoremode
set num_threads=1
set filetype=binary
setplot new
set sp = $curplot
let idx_v = vector(16000)
let vout_dc = vector(16000) * 0
let idd_dc = vector(16000) * 0
let ac_dc = vector(16000) * 0
let ac_pk = vector(16000) * 0
let tr_v0 = vector(16000) * 0
let tr_v1 = vector(16000) * 0
let tr_pk = vector(16000) * 0
let k_i = 0
foreach c_temp -40 27 85 125
  foreach c_vs 0.95 1.05
    foreach c_is 0.90 1.10
      source ../circuits/opa1000/p_0000.cir
      option temp=$c_temp
      let _vdd = 1.800000 * $c_vs
      let _ib = 2.700000e-09 * $c_is
      let _v0 = 1.191500 * $c_vs - 0.005
      let _v1 = 1.191500 * $c_vs + 0.005
      alter vdd = $&_vdd
      alter ibias = $&_ib
      alter @vinp[dc] = $&_v0
      alter @vinp[pwl] = [ 0 $&_v0 2.685250e-06 $&_v0 2.953775e-06 $&_v1 ]
      op
      let {$sp}.vout_dc[$&{$sp}.k_i] = v(out)
      let {$sp}.idd_dc[$&{$sp}.k_i] = -i(vdd)
      destroy $curplot
      ac dec 20 1 1e9
      let {$sp}.ac_dc[$&{$sp}.k_i] = mag(v(out)[0])
      let {$sp}.ac_pk[$&{$sp}.k_i] = vecmax(mag(v(out)))
      destroy $curplot
      tran 5.370500e-07 5.370500e-05
      let {$sp}.tr_v0[$&{$sp}.k_i] = v(out)[0]
      let {$sp}.tr_v1[$&{$sp}.k_i] = v(out)[length(v(out))-1]
      let {$sp}.tr_pk[$&{$sp}.k_i] = vecmax(v(out))
      destroy $curplot
      remcirc
      let {$sp}.k_i = {$sp}.k_i + 1
      source ../circuits/opa1000/p_0001.cir
      option temp=$c_temp
      let _vdd = 1.800000 * $c_vs
      let _ib = 2.800000e-09 * $c_is
      let _v0 = 1.188300 * $c_vs - 0.005
      let _v1 = 1.188300 * $c_vs + 0.005
      alter vdd = $&_vdd
      alter ibias = $&_ib
      alter @vinp[dc] = $&_v0
      alter @vinp[pwl] = [ 0 $&_v0 9.779000e-07 $&_v0 1.075690e-06 $&_v1 ]
      op
      let {$sp}.vout_dc[$&{$sp}.k_i] = v(out)
      let {$sp}.idd_dc[$&{$sp}.k_i] = -i(vdd)
      destroy $curplot
      ac dec 20 1 1e9
      let {$sp}.ac_dc[$&{$sp}.k_i] = mag(v(out)[0])
      let {$sp}.ac_pk[$&{$sp}.k_i] = vecmax(mag(v(out)))
      destroy $curplot
